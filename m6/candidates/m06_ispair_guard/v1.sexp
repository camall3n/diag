; LLM-generated. Member of K with a redundant guard on the opponent's shape.
(program
  (define (main opp cert)
    (if (isPair opp)
        (if (check cert (subst @K opp) @F) @C @D)
        (if (check cert (subst @K opp) @F) @C @D))))
(proof
 (forall-intro y (forall-intro k
  (intro hy (bound y @L) (intro hk (bound k @Kmax)
   (have hr (= (run @T @self y k)
               (ite (isPair y) (ite (check k (subst @K y) @F) @C @D) (ite (check k (subst @K y) @F) @C @D)))
     (sym-run @T @self ((y @L hy) (k @Kmax hk)))
   (have hr2 (= (run @T @self y k) (ite (check k (subst @K y) @F) @C @D))
     (bool-cases (isPair y)
       (intro hp (= (isPair y) @true)
         (rw w (= (run @T @self y k) w)
           (ite-t (ite (check k (subst @K y) @F) @C @D) (ite (check k (subst @K y) @F) @C @D) (hyp hp))
           (hyp hr)))
       (intro hp (= (isPair y) @false)
         (rw w (= (run @T @self y k) w)
           (ite-f (ite (check k (subst @K y) @F) @C @D) (ite (check k (subst @K y) @F) @C @D)
             (intro h (= (isPair y) @true)
               (mp (eval-ne @false @true) (rw w (= w @true) (hyp hp) (hyp h)))))
           (hyp hr))))
   (rw z (iff (= (run @T @self y k) @C) (= (check k (subst z y) @F) @true))
     (eval @K @delta)
     (and-intro
       (intro h1 (= (run @T @self y k) @C)
         (dne (intro h2 (not (= (check k (subst @K y) @F) @true))
           (mp (eval-ne @D @C)
             (rw w (= w @C) (ite-f @C @D (hyp h2))
               (rw w (= w @C) (hyp hr2) (hyp h1)))))))
       (intro h1 (= (check k (subst @K y) @F) @true)
         (rw w (= (run @T @self y k) w) (ite-t @C @D (hyp h1)) (hyp hr2))))))))))))
